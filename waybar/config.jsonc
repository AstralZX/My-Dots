{
  "layer": "top",
  "position": "top",
  "height": 38,

  "spacing": 4,
  "margin-top": 6,
  "margin-bottom": 0,
  "margin-left": 6,
  "margin-right": 6,

  "modules-left": [
    "custom/menu",
    "wlr/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "tray"
  ],

  "wlr/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "custom/menu": {
    "format": " ☰ ",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d}",
    "tooltip-format": "{:%A, %B %d %Y  •  %H:%M:%S}",
    "on-click": "calendar 2>/dev/null || echo 'no calendar'"
  },

  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰲜",
    "tooltip-format": "{ifname}  •  {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor 2>/dev/null || true"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol 2>/dev/null || true",
    "scroll-step": 5
  },

  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󱘖 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "on-click": "gnome-power-statistics 2>/dev/null || true"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
